 "a3m43a.dat:10": "Nós vamos ser",
 "a3m43a.dat:11": "os melhores do mundo!",
 "a3m43a.dat:12": "Sim!",
 "a3m45a.dat:0": "Nós‥",
 "a3m45a.dat:1": "NÓS CONSEGUIMOS!!",
 "a3m45a.dat:2": "AAA",
 "a3m45a.dat:3": "‥AAA‥",
 "a3m45a.dat:4": "AAAH!",
 "a3m45a.dat:5": "NÓS",
 "a3m45a.dat:6": "VENCEMOS!",
 "a3m45a.dat:7": "Eu perdi! Parabéns, Satoru!",
 "a3m45a.dat:8": "Sua equipe é a melhor!",
 "a3m45a.dat:9": "Que dia maravilhoso, Daisuke‥",
 "a3m45a.dat:10": "Foi o melhor dia da minha vida!",
 "a3m45a.dat:11": "E creio que também foi o seu‥",
 "a3m45a.dat:12": "O nosso sonho virou realidade.",
 "a3m45a.dat:13": "É, somos os melhores do mundo!",
 "a3m45a.dat:14": "Alguém me belisca?",
 "a3m45a.dat:15": "Buaa!",
 "a3m45a.dat:16": "Isso!",
 "a3m45a.dat:17": "Eles conseguiram!",
 "a3m45a.dat:18": "Parabéns",
 "a3m45a.dat:19": "e obrigado, Endo‥",
 "a3m45a.dat:20": "Treinador‥",
 "a3m45a.dat:21": "Pra falar a verdade,",
 "a3m45a.dat:22": "foi uma péssima partida!",
 "a3m45a.dat:23": "Mas tivemos sorte",
 "a3m45a.dat:24": "e agora somos oficialmente",
 "a3m45a.dat:25": "os menos piores do mundo!",
 "a3m45a.dat:26": "Quê?",
 "a3m45a.dat:27": "!",
 "a3m45a.dat:28": "Ehem‥",
 "a3m45a.dat:29": "Bom trabalho!",
 "a3m45a.dat:30": "Treinador!",
 "a3m45a.dat:31": "Muito obrigado!",
 "a3m45a.dat:32": "Ah!",
 "a3m45a.dat:33": "Muito obrigada!",
 "a3m81a.dat:0": "Ouça, Baddap‥",
 "a3m81a.dat:2": "Entendido?",
 "a3m82a.dat:0": "Cheguei!",
 "a3m82a.dat:1": "Uau! Oitenta anos no passado!",
 "a3m82a.dat:2": "A época do meu bisavó.",
 "a3m82a.dat:3": "Haha!",
 "a3m82a.dat:4": "Estou tão animado!",
 "a3m83a.dat:0": "E ele?",
 "a3m83a.dat:1": "Uh! Ele me viu!",
 "a3m84a.dat:0": "Equipe Ogro!",
 "a3m85a.dat:0": "Bisavô!!",
 "a3m85a.dat:1": "Hm?",
 "a3m85a.dat:2": "!?",
 "a3m85a.dat:3": "Quem é você?",
 "a3m85a.dat:4": "Bisavô!",
 "a3m85a.dat:6": "Eu me chamo Kanon Endo",
 "a3m85a.dat:7": "e vim do futuro!"
